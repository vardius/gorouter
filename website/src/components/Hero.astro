---
// Replaces Starlight's hero: the pitch and its actions on one side, the code they lead to on the other.
import { Code, LinkButton, TabItem, Tabs } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/Hero.astro';

// Starlight's 404 page is a splash page too: give it the default hero, whose links don't depend on the URL.
const isLanding = Astro.locals.starlightRoute.id === '';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const install = 'go get github.com/vardius/gorouter/v5';

const nethttp = `func hello(w http.ResponseWriter, r *http.Request) {
	fmt.Fprintf(w, "hello, %s!\\n", r.PathValue("name"))
}

func main() {
	router := gorouter.New()
	router.GET("/hello/{name}", hello)
	log.Fatal(http.ListenAndServe(":8080", router))
}`;

const fasthttp = `func hello(ctx *fasthttp.RequestCtx) {
	fmt.Fprintf(ctx, "hello, %s!\\n", fastrouter.Param(ctx, "name"))
}

func main() {
	router := fastrouter.New()
	router.GET("/hello/{name}", hello)
	log.Fatal(fasthttp.ListenAndServe(":8080", router.HandleFastHTTP))
}`;
---

{
	isLanding ? (
		<div class="hero">
			<div class="pitch">
				<a class="release" href="migrating-from-v4/">
					<span class="release-tag">v5</span>
					<span>See what changed</span>
					<span aria-hidden="true">→</span>
				</a>
				<h1 id="_top" data-page-title set:html={title} />
				{tagline && <p class="tagline" set:html={tagline} />}
				{
					actions.length > 0 && (
						<div class="actions">
							{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
								<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
									{text}
									{icon?.html && <Fragment set:html={icon.html} />}
								</LinkButton>
							))}
						</div>
					)
				}
				<div class="install">
					<code>{install.split(/(?<=\/)/).map((part, i) => (i > 0 ? [<wbr />, part] : part))}</code>
					<button type="button" class="copy" data-copy={install} aria-label="Copy the install command">
						<svg class="icon-copy" viewBox="0 0 24 24" aria-hidden="true">
							<rect x="9" y="9" width="11" height="11" rx="2" />
							<path d="M5 15V6a2 2 0 0 1 2-2h9" />
						</svg>
						<svg class="icon-done" viewBox="0 0 24 24" aria-hidden="true">
							<path d="m5 12 5 5 9-10" />
						</svg>
					</button>
					<span class="sr-only" role="status"></span>
				</div>
			</div>

			<div class="sample">
				<Tabs syncKey="adapter">
					<TabItem label="net/http">
						<Code code={nethttp} lang="go" title="main.go" />
					</TabItem>
					<TabItem label="fasthttp">
						<Code code={fasthttp} lang="go" title="main.go" />
					</TabItem>
				</Tabs>
			</div>
		</div>
	) : (
		<Default />
	)
}

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.install .copy')) {
		const status = button.nextElementSibling;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
			} catch {
				// No clipboard access: select the command so it can be copied by hand.
				if (button.previousElementSibling) getSelection()?.selectAllChildren(button.previousElementSibling);
				return;
			}
			button.dataset.copied = '';
			if (status) status.textContent = 'Copied';
			setTimeout(() => {
				delete button.dataset.copied;
				if (status) status.textContent = '';
			}, 1500);
		});
	}
</script>

<style>
	.hero {
		display: grid;
		gap: 2.5rem;
		align-items: center;
		padding-block: 2rem 1rem;
	}

	.pitch {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		min-width: 0;
	}

	.release {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		max-width: 100%;
		padding: 0.25rem 0.875rem 0.25rem 0.25rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 1.25rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}

	.release:hover {
		border-color: var(--sl-color-accent);
		color: var(--sl-color-white);
	}

	.release-tag {
		flex-shrink: 0;
		padding: 0.0625rem 0.625rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.25rem, calc(1rem + 4vw), 3.75rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
	}

	h1 :global(.accent) {
		background: linear-gradient(100deg, var(--sl-color-accent), var(--sl-color-accent-high));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	@media (forced-colors: active) {
		h1 :global(.accent) {
			background: none;
			color: inherit;
		}
	}

	.tagline {
		margin: 0;
		max-width: 34rem;
		font-size: clamp(var(--sl-text-base), calc(0.5rem + 1vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 2rem;
	}

	/* The copy button sits beside the command, never over it, so the command can wrap on narrow screens. */
	.install {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
		max-width: 28rem;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-inline-code);
	}

	.install code {
		flex: 1;
		min-width: 0;
		padding: 0;
		background: none;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		overflow-wrap: anywhere;
	}

	.install code::before {
		content: '$ ';
		color: var(--sl-color-gray-3);
	}

	.copy {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: 0.375rem;
		background: none;
		color: var(--sl-color-gray-3);
		cursor: pointer;
	}

	.copy:hover,
	.copy:focus-visible {
		border-color: var(--sl-color-hairline-light);
		color: var(--sl-color-white);
	}

	.copy svg {
		grid-area: 1 / 1;
		width: 1.125rem;
		height: 1.125rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.icon-done,
	.copy[data-copied] .icon-copy {
		visibility: hidden;
	}

	.copy[data-copied] .icon-done {
		visibility: visible;
		color: var(--sl-color-accent);
	}

	.sample {
		min-width: 0;
		position: relative;
	}

	/* A soft glow behind the code, so the eye lands on it after the headline. */
	.sample::before {
		content: '';
		position: absolute;
		inset: 10% 5%;
		z-index: -1;
		border-radius: 50%;
		background: var(--sl-color-accent);
		opacity: 0.18;
		filter: blur(64px);
		pointer-events: none;
	}

	.sample :global(starlight-tabs .tab) {
		margin: 0;
	}

	.sample :global(.expressive-code) {
		margin-top: 0.75rem;
	}

	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			gap: 3.5rem;
			padding-block: 4rem 2rem;
		}
	}
</style>
